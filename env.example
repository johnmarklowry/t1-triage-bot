# Environment File Loading:
# The app loads .env first, then .env.local (if it exists) which overrides .env values.
# For local development, use .env.local (already in .gitignore) to keep your credentials separate.
# 
# To get started locally:
#   cp env.example .env.local
#   # Then edit .env.local with your local values

# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here
ADMIN_CHANNEL_ID=C1234567890

# Shared secret for web admin UI (issue #1); Bearer token or ?token= on /admin
# Used as fallback when Slack OAuth (issue #4) is configured, or sole auth when OAuth is unset.
WEB_ADMIN_SECRET=change-me-in-production

# Slack OAuth — Sign in with Slack (issue #4)
# Create a Slack app at https://api.slack.com/apps and enable "Sign in with Slack" (OpenID Connect).
# Redirect URL must match SLACK_OAUTH_REDIRECT_URI (e.g. http://localhost:3000/auth/slack/callback).
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_OAUTH_REDIRECT_URI=http://localhost:3000/auth/slack/callback
# Signs session and OAuth state cookies; use a long random string in production.
SESSION_SECRET=change-me-session-secret

# On-call user group: production uses SLACK_USERGROUP_ID; staging uses SLACK_USERGROUP_ID_STAGING (see ENVIRONMENT_COMMANDS.md).
SLACK_USERGROUP_ID=S01234567
# Staging/local: optional. If unset, the bot will find or create a user group with handle triage-oncall-staging and use it. Set this to pin a specific group.
# SLACK_USERGROUP_ID_STAGING=S01234568

# Local Dev Receiver Mode / Socket Mode
# Default behavior:
# - NODE_ENV=development + SLACK_APP_TOKEN set => Socket Mode (no tunnel needed)
# - NODE_ENV=production (or no SLACK_APP_TOKEN) => HTTP mode via /slack/events
# You can force HTTP mode in dev by setting SOCKET_MODE=false
SLACK_APP_TOKEN=xapp-your-app-token-here  # Optional: enables Socket Mode in dev
SOCKET_MODE=true  # Set to false to force HTTP mode even if SLACK_APP_TOKEN is set

# Database Configuration
# Local / Railway: set DATABASE_URL directly.
# Monorail: POSTGRES_HOST, POSTGRES_PORT, POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD
# are injected automatically; the app builds DATABASE_URL at startup with sslmode=require.
DATABASE_URL=postgresql://username:password@hostname:port/database
# Alternative: Individual database settings (for local development)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=triage_bot
# DB_USER=postgres
# DB_PASSWORD=your-database-password
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=2
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# Application Configuration
PORT=3000
NODE_ENV=development
# Staging detection: single source. Set APP_ENV=staging for staging, APP_ENV=production (or unset) for production.
APP_ENV=staging

# Seeding: JSON data migration at server startup is skipped when the DB already has data (staging and production).
# Set FORCE_SEED=1 to force the migration to run (e.g. one-time backfill or recovery).
# FORCE_SEED=1

# Cron / scheduled jobs
# Monorail: notify-rotation runs as a CronJob (see monorail.toml). No webhook secret needed.
# Railway (legacy): external cron POSTs to /jobs/railway/notify-rotation with this header.
RAILWAY_CRON_SECRET=your-railway-cron-secret
# In-app 5PM/8AM PT jobs — keep false on Monorail (use platform CronJob instead).
ENABLE_IN_APP_CRON=false

# Monorail deploy (set in Monorail console / secrets, not in repo):
# SLACK_BOT_TOKEN, SLACK_SIGNING_SECRET, ADMIN_CHANNEL_ID, SLACK_OAUTH_*,
# WEB_ADMIN_SECRET, SESSION_SECRET, APP_ENV=staging|production, etc.
# Production URL: https://triage-bot.monorail.t1infra.net
# Slack Request URL: https://triage-bot.monorail.t1infra.net/slack/events
# OAuth redirect:   https://triage-bot.monorail.t1infra.net/auth/slack/callback

# Optional: Google Sheets Integration (if used)
GOOGLE_SHEETS_CREDENTIALS_PATH=path/to/credentials.json
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id

# Optional: OpenAI Integration (if used)
OPENAI_API_KEY=your-openai-api-key
